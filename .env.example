# Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DB_PASSWORD=your_secure_database_password_here
DB_USER=expensetracker
DB_NAME=expensetracker

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id-here

# JWT Configuration
# Generate with: openssl rand -base64 32 (Linux/Mac)
# Or PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# JWT Expiration (milliseconds)
JWT_EXPIRATION=86400000

# Frontend URL
FRONTEND_URL=http://localhost

# Optional: Docker registry settings for pushing images
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_username
